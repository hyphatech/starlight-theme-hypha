---
// Starlight's scripts find the sidebar by its id.
import X from "@lucide/astro/icons/x";
import config from "virtual:starlight-theme-hypha/config";
import { say } from "../libs/words";
import Icon from "./Icon.astro";
import NamedIcon from "./NamedIcon.astro";
import PhoneNav from "./PhoneNav.astro";
import Tabs from "./Tabs.astro";

const { hasSidebar, sidebar } = Astro.locals.starlightRoute;
// An empty sidebar keeps its column, so the page doesn't shift between pages.
const navigable = hasSidebar && sidebar.length > 0;
const tabbed = (Astro.locals.hyphaTabs?.length ?? 0) > 0;
const open = Astro.locals.hyphaTabs?.find((tab) => tab.isCurrent);
const openIcon = open && typeof config.tabs === "object" ? config.tabs[open.label] : undefined;
---

<div>
  {/* Not `.header`: a page's own styles may use it (HeroUI's do). */}
  <header class="site-header hypha:sticky hypha:top-0 hypha:z-(--sl-z-index-navbar) hypha:[@media(height<30rem)]:static hypha:border-b hypha:border-rule hypha:bg-ivory"><slot name="header" /><Tabs /><PhoneNav /></header>
  <div
    class:list={[
      "hypha:mx-auto hypha:max-w-page hypha:px-(--hypha-gutter)",
      hasSidebar && "hypha:md:grid hypha:md:grid-cols-[calc(var(--hypha-margin)_-_var(--hypha-column-gap))_minmax(0,1fr)] hypha:md:gap-x-(--hypha-column-gap)",
    ]}
  >
    {
      hasSidebar && !navigable && <div aria-hidden="true" />
    }
    {
      navigable && (
        <nav class="hypha:print:hidden" aria-label={Astro.locals.t("sidebarNav.accessibleLabel")}>
          <script>
            // A popover below md; while open, the page behind is inert.
            class StarlightSidebarPane extends HTMLElement {
              constructor() {
                super();
                const wide = matchMedia("(min-width: 48rem)");
                const reset = () => {
                  this.popover = wide.matches ? null : "auto";
                };
                reset();
                wide.addEventListener("change", reset);
                this.addEventListener("toggle", ({ newState }) => {
                  document.querySelectorAll<HTMLElement>(".main-frame, .sl-skip-link, .site-header").forEach((el) => {
                    el.toggleAttribute("inert", newState === "open");
                  });
                });
              }
            }
            customElements.define("sl-sidebar-pane", StarlightSidebarPane);
          </script>
          <script>
            // The state changes a tick after the click, where Starlight's
            // script reads it to keep open groups across pages.
            const still = matchMedia("(prefers-reduced-motion: reduce)");
            document.querySelectorAll<HTMLDetailsElement>("#starlight__sidebar details").forEach((details) => {
              const summary = details.querySelector<HTMLElement>(":scope > summary");
              if (!summary) return;
              let running: Animation | undefined;
              let open = details.open;
              summary.addEventListener("click", (event) => {
                if (still.matches) return;
                event.preventDefault();
                open = !open;
                setTimeout(() => {
                  const from = details.getBoundingClientRect().height;
                  running?.cancel();
                  details.open = true;
                  details.toggleAttribute("data-closing", !open);
                  const to = open ? details.getBoundingClientRect().height : summary.getBoundingClientRect().height;
                  details.style.overflow = "hidden";
                  running = details.animate(
                    { height: [`${from}px`, `${to}px`] },
                    { duration: 220, easing: "cubic-bezier(0.4, 0, 0.2, 1)" },
                  );
                  running.onfinish = () => {
                    details.open = open;
                    details.removeAttribute("data-closing");
                    details.style.overflow = "";
                    running = undefined;
                  };
                });
              });
            });
          </script>
          {/* Padding offset by negative margin leaves room for focus rings. */}
          <sl-sidebar-pane
            popover=""
            id="starlight__sidebar"
            class="hypha:fixed hypha:inset-0 hypha:z-(--sl-z-index-menu) hypha:m-0 hypha:h-full hypha:max-h-none hypha:w-full hypha:max-w-none hypha:overflow-y-auto hypha:border-0 hypha:bg-ivory hypha:p-0 hypha:text-inherit hypha:md:no-scrollbar hypha:md:sticky hypha:md:inset-auto hypha:md:top-(--sl-nav-height) hypha:md:z-auto hypha:md:-mx-1.5 hypha:md:block hypha:md:h-auto hypha:md:max-h-[calc(100dvh_-_var(--sl-nav-height))] hypha:md:bg-transparent hypha:md:px-1.5"
          >
            <div class="hypha:flex hypha:h-16 hypha:items-center hypha:justify-between hypha:gap-4 hypha:border-b hypha:border-rule hypha:px-(--hypha-gutter) hypha:md:hidden">
              <span class="hypha:t-control hypha:flex hypha:min-w-0 hypha:items-center hypha:gap-2 hypha:text-ink">
                {openIcon && <NamedIcon name={openIcon} />}
                <span class="hypha:truncate">{open?.label}</span>
              </span>
              <button
                type="button"
                popovertarget="starlight__sidebar"
                popovertargetaction="hide"
                aria-label={say(Astro.locals.t, "hypha.menu.close")}
                class="hypha:grid hypha:size-11 hypha:cursor-pointer hypha:place-items-center hypha:rounded-control hypha:border hypha:border-rule hypha:bg-panel hypha:text-graphite"
              >
                <Icon icon={X} size="md" />
              </button>
            </div>
            <div class="sidebar-content hypha:px-(--hypha-gutter) hypha:pt-8 hypha:pb-12 hypha:md:px-0 hypha:md:pt-(--hypha-page-top) hypha:md:pb-8" data-tabbed={tabbed ? "" : undefined}>
              <slot name="sidebar" />
            </div>
          </sl-sidebar-pane>
        </nav>
      )
    }
    <div class="main-frame hypha:min-w-0"><slot /></div>
  </div>
</div>
