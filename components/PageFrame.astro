---
// hypha.pub's grid: the header across the window, then the page's width
// with the navigation in its margin. On a phone the navigation is a sheet
// over the page; Starlight's scripts find it by its id.
import X from "@lucide/astro/icons/x";
import Icon from "./Icon.astro";
import PhoneNav from "./PhoneNav.astro";
import Tabs from "./Tabs.astro";

const { hasSidebar, sidebar } = Astro.locals.starlightRoute;
// An empty sidebar keeps its margin, so the page stands where its
// neighbours' do.
const navigable = hasSidebar && sidebar.length > 0;
const tabbed = (Astro.locals.hyphaTabs?.length ?? 0) > 0;
---

<div>
  {/* Not `.header`, which a page's own styles may take: HeroUI's do. */}
  <header class="site-header border-b border-rule"><slot name="header" /><Tabs /><PhoneNav /></header>
  <div
    class:list={[
      "mx-auto max-w-page px-(--gutter)",
      hasSidebar && "md:grid md:grid-cols-[calc(var(--margin)_-_var(--column-gap))_minmax(0,1fr)] md:gap-x-(--column-gap)",
    ]}
  >
    {
      hasSidebar && !navigable && <div aria-hidden="true" />
    }
    {
      navigable && (
        <nav class="print:hidden" aria-label={Astro.locals.t("sidebarNav.accessibleLabel")}>
          <script>
            // A popover on a phone, part of the page wider. While it is open,
            // the page behind it takes no focus.
            class StarlightSidebarPane extends HTMLElement {
              constructor() {
                super();
                const wide = matchMedia("(min-width: 48rem)");
                const reset = () => {
                  this.popover = wide.matches ? null : "auto";
                };
                reset();
                wide.addEventListener("change", reset);
                this.addEventListener("toggle", ({ newState }) => {
                  document.querySelectorAll<HTMLElement>(".main-frame, .sl-skip-link, .site-header").forEach((el) => {
                    el.toggleAttribute("inert", newState === "open");
                  });
                });
              }
            }
            customElements.define("sl-sidebar-pane", StarlightSidebarPane);
          </script>
          <script>
            // A group slides open and shut from wherever it stands. Its state
            // changes after the click, which Starlight's script reads to keep
            // the open groups from page to page.
            const still = matchMedia("(prefers-reduced-motion: reduce)");
            document.querySelectorAll<HTMLDetailsElement>("#starlight__sidebar details").forEach((details) => {
              const summary = details.querySelector<HTMLElement>(":scope > summary");
              if (!summary) return;
              let running: Animation | undefined;
              let open = details.open;
              summary.addEventListener("click", (event) => {
                if (still.matches) return;
                event.preventDefault();
                open = !open;
                setTimeout(() => {
                  const from = details.getBoundingClientRect().height;
                  running?.cancel();
                  details.open = true;
                  details.toggleAttribute("data-closing", !open);
                  const to = open ? details.getBoundingClientRect().height : summary.getBoundingClientRect().height;
                  details.style.overflow = "hidden";
                  running = details.animate(
                    { height: [`${from}px`, `${to}px`] },
                    { duration: 220, easing: "cubic-bezier(0.4, 0, 0.2, 1)" },
                  );
                  running.onfinish = () => {
                    details.open = open;
                    details.removeAttribute("data-closing");
                    details.style.overflow = "";
                    running = undefined;
                  };
                });
              });
            });
          </script>
          {/* Wider, sticky; its padding, taken back by its margin, is room
             for a link's focus ring. */}
          <sl-sidebar-pane
            popover=""
            id="starlight__sidebar"
            class="fixed inset-0 z-(--sl-z-index-menu) m-0 h-full max-h-none w-full max-w-none overflow-y-auto border-0 bg-ivory p-0 text-inherit md:no-scrollbar md:sticky md:inset-auto md:top-0 md:z-auto md:-mx-1.5 md:block md:h-auto md:max-h-dvh md:bg-transparent md:px-1.5"
          >
            <div class="flex h-16 items-center justify-end border-b border-rule px-(--gutter) md:hidden">
              <button
                type="button"
                popovertarget="starlight__sidebar"
                popovertargetaction="hide"
                aria-label="Close the menu"
                class="grid size-11 cursor-pointer place-items-center rounded-control border border-rule bg-panel text-graphite"
              >
                <Icon icon={X} size="md" />
              </button>
            </div>
            <div class="sidebar-content px-(--gutter) pt-8 pb-12 md:px-0 md:pt-(--page-top) md:pb-8" data-tabbed={tabbed ? "" : undefined}>
              <slot name="sidebar" />
            </div>
          </sl-sidebar-pane>
        </nav>
      )
    }
    <div class="main-frame min-w-0"><slot /></div>
  </div>
</div>
