---
// The page's contents, sticky beside the text. Its padding, taken back by
// its margin, is room for a link's focus ring.
import TableOfContents from "@astrojs/starlight/components/TableOfContents.astro";
---

<div class="no-scrollbar sticky top-0 -mx-1.5 max-h-dvh overflow-y-auto px-1.5 pt-(--page-top) pb-8">
  <TableOfContents />
</div>
