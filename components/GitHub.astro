---
// The project's repository, as Zensical's header shows it: GitHub's mark,
// then its latest version, its stars and its forks, asked of GitHub's API by
// the reader's browser and kept for the session, so a page built once stays
// current. Until they come, or if they never do, the link stands alone.
import GitFork from "@lucide/astro/icons/git-fork";
import Star from "@lucide/astro/icons/star";
import Tag from "@lucide/astro/icons/tag";
import config from "virtual:starlight-theme-hypha/config";
import Icon from "./Icon.astro";

interface Props {
  // On one line, the facts after the name, for a row as tall as a link.
  inline?: boolean;
}

const { inline = false } = Astro.props;
---

{
  config.github && (
    <a href={`https://github.com/${config.github}`} target="_blank" rel="noopener" class:list={["github", { inline }]} data-github={config.github} aria-label={`${config.github} on GitHub`}>
      <svg viewBox="0 0 16 16" width="20" height="20" aria-hidden="true" class="mark">
        <path
          fill="currentColor"
          d="M8 0c4.42 0 8 3.58 8 8a8.013 8.013 0 0 1-5.45 7.59c-.4.08-.55-.17-.55-.38 0-.27.01-1.13.01-2.2 0-.75-.25-1.23-.54-1.48 1.78-.2 3.65-.88 3.65-3.95 0-.88-.31-1.59-.82-2.15.08-.2.36-1.02-.08-2.12 0 0-.67-.22-2.2.82-.64-.18-1.32-.27-2-.27-.68 0-1.36.09-2 .27-1.53-1.03-2.2-.82-2.2-.82-.44 1.1-.16 1.92-.08 2.12-.51.56-.82 1.28-.82 2.15 0 3.06 1.86 3.75 3.64 3.95-.23.2-.44.55-.51 1.07-.46.21-1.61.55-2.33-.66-.15-.24-.6-.83-1.23-.82-.67.01-.27.38.01.53.34.19.73.9.82 1.13.16.45.68 1.31 2.69.94 0 .67.01 1.3.01 1.49 0 .21-.15.45-.55.38A7.995 7.995 0 0 1 0 8c0-4.42 3.58-8 8-8Z"
        />
      </svg>
      <span class="text" aria-hidden="true">
        <span class="name">GitHub</span>
        <span class="facts">
          <span data-fact="version" hidden><Icon icon={Tag} size="xs" /><span /></span>
          <span data-fact="stars" hidden><Icon icon={Star} size="xs" /><span /></span>
          <span data-fact="forks" hidden><Icon icon={GitFork} size="xs" /><span /></span>
        </span>
      </span>
    </a>
  )
}

<script>
  interface Facts {
    version?: string;
    stars: number;
    forks: number;
  }

  // GitHub allows a reader sixty unauthenticated requests an hour: each
  // repository is asked once a session.
  const key = (repo: string) => `starlight-theme-hypha:github:${repo}`;

  async function ask(repo: string): Promise<Facts | undefined> {
    try {
      const kept = sessionStorage.getItem(key(repo));
      if (kept) return JSON.parse(kept) as Facts;
    } catch {}
    try {
      const api = `https://api.github.com/repos/${repo}`;
      const [found, release] = await Promise.all([fetch(api), fetch(`${api}/releases/latest`)]);
      if (!found.ok) return undefined;
      const { stargazers_count: stars, forks_count: forks } = await found.json();
      // A repository with tags and no release names its version by its tag.
      let tag: string | undefined = release.ok ? (await release.json()).tag_name : undefined;
      if (!tag) {
        const tags = await fetch(`${api}/tags?per_page=1`);
        if (tags.ok) tag = (await tags.json())[0]?.name;
      }
      const facts: Facts = { version: tag?.replace(/^v(?=\d)/, ""), stars, forks };
      try {
        sessionStorage.setItem(key(repo), JSON.stringify(facts));
      } catch {}
      return facts;
    } catch {
      return undefined;
    }
  }

  const count = new Intl.NumberFormat("en", { notation: "compact" });

  document.querySelectorAll<HTMLAnchorElement>("a[data-github]").forEach(async (link) => {
    const repo = link.dataset.github!;
    const facts = await ask(repo);
    if (!facts) return;
    const shown: [string, string | undefined, string][] = [
      ["version", facts.version, `version ${facts.version}`],
      ["stars", count.format(facts.stars), `${facts.stars} stars`],
      ["forks", count.format(facts.forks), `${facts.forks} forks`],
    ];
    const said = [`${repo} on GitHub`];
    for (const [name, text, spoken] of shown) {
      const fact = link.querySelector<HTMLElement>(`[data-fact="${name}"]`);
      if (!fact || text === undefined) continue;
      fact.lastElementChild!.textContent = text;
      fact.hidden = false;
      said.push(spoken);
    }
    link.setAttribute("aria-label", said.join(", "));
    link.dataset.ready = "";
  });
</script>

<style>
  .github {
    display: inline-flex;
    align-items: center;
    gap: 0.625rem;
    color: var(--graphite);
    text-decoration: none;
    white-space: nowrap;
    transition: color 120ms var(--ease-state);
  }
  .github:hover {
    color: var(--paper);
  }
  .mark {
    flex-shrink: 0;
  }
  .text {
    display: grid;
    gap: 0.125rem;
  }
  .name {
    font-size: 0.875rem;
    font-weight: 500;
    line-height: 1.15;
  }
  /* The facts' line is held open before they come, so the header does not
     move when they do; they fade in. */
  .facts {
    display: flex;
    gap: 0.625rem;
    min-height: 0.875rem;
    font-size: 0.6875rem;
    font-weight: 500;
    line-height: 0.875rem;
    font-variant-numeric: tabular-nums;
    opacity: 0;
    transition: opacity 200ms var(--ease-state);
  }
  .github[data-ready] .facts {
    opacity: 1;
  }
  .facts > span {
    display: inline-flex;
    align-items: center;
    gap: 0.25rem;
  }
  .facts > span[hidden] {
    display: none;
  }
  .inline .mark {
    width: 16px;
    height: 16px;
  }
  .inline .text {
    display: flex;
    align-items: center;
    gap: 0.625rem;
  }
</style>
