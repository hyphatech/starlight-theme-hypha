---
// The project's repository, as Zensical's header shows it: GitHub's mark,
// which says what it is, then its latest version, its stars and its forks,
// on one line. They are asked of GitHub's API as the site is built, so the
// header is drawn with them and does not move, and again by the reader's
// browser, once a session, so a page built once stays current. If GitHub
// cannot be reached, the mark stands alone.
import GitFork from "@lucide/astro/icons/git-fork";
import Star from "@lucide/astro/icons/star";
import Tag from "@lucide/astro/icons/tag";
import config from "virtual:starlight-theme-hypha/config";
import { atBuild, shown } from "../libs/github";
import Icon from "./Icon.astro";

const repo = config.github;
const facts = repo ? shown(repo, await atBuild(repo)) : undefined;
const has = (name: string) => facts?.items.find((item) => item.name === name)?.text;
---

{
  repo && facts && (
    <a href={`https://github.com/${repo}`} target="_blank" rel="noopener" class="github" data-github={repo} aria-label={facts.label}>
      <svg viewBox="0 0 16 16" width="18" height="18" aria-hidden="true" class="mark">
        <path
          fill="currentColor"
          d="M8 0c4.42 0 8 3.58 8 8a8.013 8.013 0 0 1-5.45 7.59c-.4.08-.55-.17-.55-.38 0-.27.01-1.13.01-2.2 0-.75-.25-1.23-.54-1.48 1.78-.2 3.65-.88 3.65-3.95 0-.88-.31-1.59-.82-2.15.08-.2.36-1.02-.08-2.12 0 0-.67-.22-2.2.82-.64-.18-1.32-.27-2-.27-.68 0-1.36.09-2 .27-1.53-1.03-2.2-.82-2.2-.82-.44 1.1-.16 1.92-.08 2.12-.51.56-.82 1.28-.82 2.15 0 3.06 1.86 3.75 3.64 3.95-.23.2-.44.55-.51 1.07-.46.21-1.61.55-2.33-.66-.15-.24-.6-.83-1.23-.82-.67.01-.27.38.01.53.34.19.73.9.82 1.13.16.45.68 1.31 2.69.94 0 .67.01 1.3.01 1.49 0 .21-.15.45-.55.38A7.995 7.995 0 0 1 0 8c0-4.42 3.58-8 8-8Z"
        />
      </svg>
      <span class="facts" aria-hidden="true">
        <span data-fact="version" hidden={!has("version")}>
          <Icon icon={Tag} size="xs" />
          <span>{has("version")}</span>
        </span>
        <span data-fact="stars" hidden={!has("stars")}>
          <Icon icon={Star} size="xs" />
          <span>{has("stars")}</span>
        </span>
        <span data-fact="forks" hidden={!has("forks")}>
          <Icon icon={GitFork} size="xs" />
          <span>{has("forks")}</span>
        </span>
      </span>
    </a>
  )
}

<script>
  import { ask, shown, type Facts } from "../libs/github";

  const key = (repo: string) => `starlight-theme-hypha:github:${repo}`;

  async function current(repo: string): Promise<Facts | undefined> {
    try {
      const kept = sessionStorage.getItem(key(repo));
      if (kept) return JSON.parse(kept) as Facts;
    } catch {}
    const facts = await ask(repo);
    if (facts) {
      try {
        sessionStorage.setItem(key(repo), JSON.stringify(facts));
      } catch {}
    }
    return facts;
  }

  document.querySelectorAll<HTMLAnchorElement>("a[data-github]").forEach(async (link) => {
    const repo = link.dataset.github!;
    const facts = await current(repo);
    if (!facts) return;
    const { items, label } = shown(repo, facts);
    for (const { name, text } of items) {
      const fact = link.querySelector<HTMLElement>(`[data-fact="${name}"]`);
      if (!fact) continue;
      fact.lastElementChild!.textContent = text ?? "";
      fact.hidden = false;
    }
    link.setAttribute("aria-label", label);
  });
</script>

<style>
  .github {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    color: var(--graphite);
    text-decoration: none;
    white-space: nowrap;
    transition: color 120ms var(--ease-state);
  }
  .github:hover {
    color: var(--paper);
  }
  .mark {
    flex-shrink: 0;
  }
  .facts {
    display: flex;
    gap: 0.625rem;
    font-size: 0.75rem;
    font-weight: 500;
    line-height: 1;
    font-variant-numeric: tabular-nums;
  }
  .facts:not(:has(> span:not([hidden]))) {
    display: none;
  }
  .facts > span {
    display: inline-flex;
    align-items: center;
    gap: 0.25rem;
  }
  .facts > span[hidden] {
    display: none;
  }
</style>
