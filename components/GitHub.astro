---
// The repository: GitHub's mark, then its version, stars and forks, as
// Zensical's header shows them. They are asked at build time, so the page
// is drawn with them and the reader's browser asks nothing.
import GitFork from "@lucide/astro/icons/git-fork";
import Star from "@lucide/astro/icons/star";
import Tag from "@lucide/astro/icons/tag";
import config, { cacheDir } from "virtual:starlight-theme-hypha/config";
import { atBuild, shown } from "../libs/github";
import Icon from "./Icon.astro";

interface Props {
  // In a phone's row of links.
  row?: boolean;
}

const { row = false } = Astro.props;
const github = config.github;
const facts = github && shown(github.repo, github.stats ? await atBuild(github.repo, cacheDir) : undefined);
const icons = { version: Tag, stars: Star, forks: GitFork };
// A phone's row has room for the stars alone; the label still reads them all.
const items = facts ? facts.items.filter(({ name }) => !row || name === "stars") : [];
---

{
  github && facts && (
    <a href={`https://github.com/${github.repo}`} target="_blank" rel="noopener" class={row ? "hypha:row-link" : "hypha:bar-link"} aria-label={facts.label}>
      <svg viewBox="0 0 16 16" width="18" height="18" aria-hidden="true" class="hypha:shrink-0">
        <path
          fill="currentColor"
          d="M8 0c4.42 0 8 3.58 8 8a8.013 8.013 0 0 1-5.45 7.59c-.4.08-.55-.17-.55-.38 0-.27.01-1.13.01-2.2 0-.75-.25-1.23-.54-1.48 1.78-.2 3.65-.88 3.65-3.95 0-.88-.31-1.59-.82-2.15.08-.2.36-1.02-.08-2.12 0 0-.67-.22-2.2.82-.64-.18-1.32-.27-2-.27-.68 0-1.36.09-2 .27-1.53-1.03-2.2-.82-2.2-.82-.44 1.1-.16 1.92-.08 2.12-.51.56-.82 1.28-.82 2.15 0 3.06 1.86 3.75 3.64 3.95-.23.2-.44.55-.51 1.07-.46.21-1.61.55-2.33-.66-.15-.24-.6-.83-1.23-.82-.67.01-.27.38.01.53.34.19.73.9.82 1.13.16.45.68 1.31 2.69.94 0 .67.01 1.3.01 1.49 0 .21-.15.45-.55.38A7.995 7.995 0 0 1 0 8c0-4.42 3.58-8 8-8Z"
        />
      </svg>
      {items.length > 0 && (
        <span class="hypha:flex hypha:gap-2.5 hypha:text-xs/none hypha:font-medium hypha:tabular-nums" aria-hidden="true">
          {items.map(({ name, text }) => (
            <span class="hypha:inline-flex hypha:items-center hypha:gap-1">
              <Icon icon={icons[name]} size="xs" />
              <span>{text}</span>
            </span>
          ))}
        </span>
      )}
    </a>
  )
}
