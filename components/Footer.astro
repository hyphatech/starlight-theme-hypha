---
// Starlight's footer, with room below it before the page ends.
import EditLink from "@astrojs/starlight/components/EditLink.astro";
import LastUpdated from "@astrojs/starlight/components/LastUpdated.astro";
import Pagination from "@astrojs/starlight/components/Pagination.astro";
---

<footer class="hypha:flex hypha:flex-col hypha:gap-6 hypha:pb-16">
  <div class="hypha:mt-12 hypha:flex hypha:flex-wrap hypha:justify-between hypha:gap-x-12 hypha:gap-y-3 hypha:text-[0.875rem] hypha:text-graphite hypha:empty:hidden">
    <EditLink />
    <LastUpdated />
  </div>
  <Pagination />
</footer>
