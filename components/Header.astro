---
// The wordmark, then search at the end, and on a phone the menu's button.
// The links are in the second row.
import Menu from "@lucide/astro/icons/menu";
import config from "virtual:starlight-theme-hypha/config";
import Search from "virtual:starlight/components/Search";
import Icon from "./Icon.astro";
import SiteTitle from "./SiteTitle.astro";

const { hasSidebar, sidebar } = Astro.locals.starlightRoute;
---

<div class="hypha:mx-auto hypha:flex hypha:h-16 hypha:max-w-page hypha:items-center hypha:gap-6 hypha:px-(--hypha-gutter)">
  <SiteTitle />
  <div class="hypha:ms-auto hypha:flex hypha:items-center hypha:gap-2 hypha:md:gap-6 hypha:print:hidden">
    <Search />
    {
      hasSidebar && sidebar.length > 0 && (
        <button
          type="button"
          popovertarget="starlight__sidebar"
          class="hypha:grid hypha:size-11 hypha:cursor-pointer hypha:place-items-center hypha:rounded-control hypha:border hypha:border-rule hypha:bg-panel hypha:text-graphite hypha:transition-colors hypha:hover:border-graphite hypha:hover:text-ink hypha:md:hidden"
          aria-label={Astro.locals.t("menuButton.accessibleLabel")}
        >
          <Icon icon={Menu} size="md" />
        </button>
      )
    }
  </div>
</div>
