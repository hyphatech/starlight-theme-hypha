---
// The wordmark, then search and the project's links. On a phone the links
// move to a second row, and the menu's button takes their place.
import Menu from "@lucide/astro/icons/menu";
import config from "virtual:starlight-theme-hypha/config";
import Search from "virtual:starlight/components/Search";
import GitHub from "./GitHub.astro";
import Icon from "./Icon.astro";
import Links from "./Links.astro";
import SiteTitle from "./SiteTitle.astro";

const { hasSidebar, sidebar } = Astro.locals.starlightRoute;
---

<div class="mx-auto flex h-16 max-w-page items-center gap-6 px-(--gutter)">
  <SiteTitle />
  <div class="ms-auto flex items-center gap-2 md:gap-6 print:hidden">
    <Search />
    {
      (config.links.length > 0 || config.github) && (
        <nav class="hidden items-center gap-6 md:flex" aria-label="Site">
          <Links />
          <GitHub />
        </nav>
      )
    }
    {
      hasSidebar && sidebar.length > 0 && (
        <button
          type="button"
          popovertarget="starlight__sidebar"
          class="grid size-11 cursor-pointer place-items-center rounded-control border border-rule bg-panel text-graphite transition-colors hover:border-graphite hover:text-ink md:hidden"
          aria-label={Astro.locals.t("menuButton.accessibleLabel")}
        >
          <Icon icon={Menu} size="md" />
        </button>
      )
    }
  </div>
</div>
