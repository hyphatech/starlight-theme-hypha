---
// Stored under Starlight's key; ThemeProvider applies it before paint.
import Laptop from "@lucide/astro/icons/laptop";
import Moon from "@lucide/astro/icons/moon";
import Sun from "@lucide/astro/icons/sun";
import config from "virtual:starlight-theme-hypha/config";
import Icon from "./Icon.astro";

const t = Astro.locals.t;
const label = t("themeSelect.accessibleLabel");
const labels = { light: t("themeSelect.light"), dark: t("themeSelect.dark"), auto: t("themeSelect.auto") };
const choices = [
  ["light", Sun],
  ["dark", Moon],
  ["auto", Laptop],
] as const;
---

{
  config.themeSelect && (
    <>
      <div class="hypha:contents">
        <div role="group" aria-label={label} class="hypha:relative hypha:hidden hypha:h-10 hypha:items-center hypha:gap-0.5 hypha:rounded-control hypha:border hypha:border-rule hypha:bg-panel hypha:p-[3px] hypha:min-[50rem]:not-pointer-coarse:flex">
          {/* One button's width and gap per step; mirrored right to left. */}
          <span
            data-pill
            aria-hidden="true"
            class="hypha:absolute hypha:start-[3px] hypha:top-[3px] hypha:size-8 hypha:rounded-[3px] hypha:bg-raised hypha:translate-x-[calc(var(--hypha-choice)*(2rem+2px))] hypha:rtl:translate-x-[calc(var(--hypha-choice)*(-2rem-2px))] hypha:transition-[translate] hypha:duration-220 hypha:ease-glide hypha:motion-reduce:transition-none"
          />
          {choices.map(([choice, drawn]) => (
            <button
              type="button"
              data-set={choice}
              aria-pressed={choice === config.scheme ? "true" : "false"}
              aria-label={labels[choice]}
              title={labels[choice]}
              class="hypha:relative hypha:grid hypha:size-8 hypha:cursor-pointer hypha:place-items-center hypha:rounded-[3px] hypha:border-0 hypha:bg-transparent hypha:p-0 hypha:text-graphite hypha:transition-colors hypha:hover:text-ink hypha:aria-pressed:text-ink"
            >
              <Icon icon={drawn} size="sm" />
            </button>
          ))}
        </div>
        <button
          type="button"
          data-cycle
          aria-label={`${label}: ${labels[config.scheme]}`}
          class="hypha:grid hypha:size-11 hypha:cursor-pointer hypha:place-items-center hypha:rounded-control hypha:border hypha:border-rule hypha:bg-panel hypha:text-graphite hypha:transition-colors hypha:hover:border-graphite hypha:hover:text-ink hypha:min-[50rem]:not-pointer-coarse:hidden"
        >
          {choices.map(([choice, drawn]) => (
            <span
              data-choice={choice}
              data-on={choice === config.scheme ? "" : undefined}
              class="hypha:col-start-1 hypha:row-start-1 hypha:grid hypha:scale-75 hypha:-rotate-45 hypha:opacity-0 hypha:transition-[opacity,scale,rotate] hypha:duration-200 hypha:ease-glide hypha:data-on:scale-100 hypha:data-on:rotate-0 hypha:data-on:opacity-100 hypha:motion-reduce:scale-100 hypha:motion-reduce:rotate-0 hypha:motion-reduce:transition-opacity"
            >
              <Icon icon={drawn} size="md" />
            </span>
          ))}
        </button>
      </div>
      <script is:inline define:vars={{ label, labels }}>
        const root = document.documentElement;
        const select = document.currentScript.previousElementSibling;
        const light = matchMedia("(prefers-color-scheme: light)");
        const still = matchMedia("(prefers-reduced-motion: reduce)");
        const order = ["light", "dark", "auto"];
        const cycle = ["auto", "light", "dark"];

        const mark = (choice) => {
          select.querySelector("[data-pill]").style.setProperty("--hypha-choice", order.indexOf(choice));
          for (const button of select.querySelectorAll("[data-set]")) button.setAttribute("aria-pressed", button.dataset.set === choice);
          for (const icon of select.querySelectorAll("[data-choice]")) icon.toggleAttribute("data-on", icon.dataset.choice === choice);
          select.querySelector("[data-cycle]").setAttribute("aria-label", `${label}: ${labels[choice]}`);
        };
        const show = (choice) => {
          root.dataset.hyphaChoice = choice;
          root.dataset.theme = choice === "auto" ? (light.matches ? "light" : "dark") : choice;
          mark(choice);
        };
        // Only a visitor's choice is stored, so a later change to the site's
        // default still reaches everyone else.
        const choose = (choice) => {
          try {
            localStorage.setItem("starlight-theme", choice);
          } catch {}
          if (!document.startViewTransition || still.matches) show(choice);
          else document.startViewTransition(() => show(choice));
        };

        mark(root.dataset.hyphaChoice);
        for (const button of select.querySelectorAll("[data-set]")) button.addEventListener("click", () => choose(button.dataset.set));
        select.querySelector("[data-cycle]").addEventListener("click", () => choose(cycle[(cycle.indexOf(root.dataset.hyphaChoice) + 1) % cycle.length]));
      </script>
    </>
  )
}
