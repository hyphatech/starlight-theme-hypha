---
// The header's links at the foot of the navigation's sheet, where a phone's
// header has no room for them; wider, the header shows them.
import config from "virtual:starlight-theme-hypha/config";
import GitHub from "./GitHub.astro";
import Links from "./Links.astro";
---

{
  (config.links.length > 0 || config.github) && (
    <nav class="elsewhere" aria-label="Elsewhere">
      <Links />
      <GitHub />
    </nav>
  )
}

<style>
  .elsewhere {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 1.5rem;
    margin-top: 2rem;
    border-top: 1px solid var(--rule);
    padding-top: 1.5rem;
  }
  @media (min-width: 48rem) {
    .elsewhere {
      display: none;
    }
  }
</style>
