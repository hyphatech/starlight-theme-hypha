---
// Sets the scheme before paint. ThemeSelect reads the choice from `data-hypha-choice`.
import config from "virtual:starlight-theme-hypha/config";
---

<script is:inline define:vars={{ scheme: config.scheme, remembers: config.themeSelect }}>
  const root = document.documentElement;
  const light = matchMedia("(prefers-color-scheme: light)");
  let choice = scheme;
  if (remembers) {
    try {
      const stored = localStorage.getItem("starlight-theme");
      if (["auto", "light", "dark"].includes(stored)) choice = stored;
    } catch {}
  }
  root.dataset.hyphaChoice = choice;
  const apply = () => {
    const chosen = root.dataset.hyphaChoice;
    root.dataset.theme = chosen === "auto" ? (light.matches ? "light" : "dark") : chosen;
  };
  apply();
  light.addEventListener("change", apply);
</script>
