---
// A feature: its icon and title over a rule, what it is, and a link to
// read more, each a row of the grid's, so a row of cards lines up.
import ArrowRight from "@lucide/astro/icons/arrow-right";
import type { IconName } from "../libs/config";
import Icon from "./Icon.astro";
import NamedIcon from "./NamedIcon.astro";

interface Props {
  title: string;
  icon?: IconName;
  href?: string;
  linkText?: string;
}

const { title, icon, href, linkText = "Read more" } = Astro.props;
---

<article class="hypha:row-span-3 hypha:grid hypha:grid-rows-subgrid hypha:gap-y-4 hypha:rounded-panel hypha:border hypha:border-rule hypha:bg-panel hypha:p-6">
  <h3 class="hypha:flex hypha:items-center hypha:gap-3 hypha:border-b hypha:border-rule hypha:pb-4 hypha:font-serif hypha:text-lg hypha:leading-tight hypha:font-normal hypha:text-ink">
    {icon && <span class="hypha:text-graphite"><NamedIcon name={icon} size="md" /></span>}
    {title}
  </h3>
  <div
    class="hypha:leading-relaxed hypha:text-graphite hypha:[&_code]:rounded-control hypha:[&_code]:bg-raised hypha:[&_code]:px-[0.36em] hypha:[&_code]:py-[0.12em] hypha:[&_code]:font-mono hypha:[&_code]:text-[0.875em]"
  >
    <slot />
  </div>
  <div class="hypha:self-end">
    {
      href && (
        <a href={href} class="hypha:btn hypha:mt-2 hypha:no-underline">
          {linkText}
          <Icon icon={ArrowRight} />
        </a>
      )
    }
  </div>
</article>
