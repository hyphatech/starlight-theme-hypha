---
import ArrowRight from "@lucide/astro/icons/arrow-right";
import type { IconName } from "../libs/config";
import { withBase } from "../libs/link";
import { say } from "../libs/words";
import Icon from "./Icon.astro";
import NamedIcon from "./NamedIcon.astro";

interface Props {
  title: string;
  icon?: IconName;
  href?: string;
  linkText?: string;
  level?: 2 | 3 | 4 | 5 | 6;
}

const { title, icon, href, linkText = say(Astro.locals.t, "hypha.feature.readMore"), level = 2 } = Astro.props;
const Heading = `h${level}` as const;
---

<article class="hypha:row-span-3 hypha:grid hypha:grid-rows-subgrid hypha:gap-y-4 hypha:rounded-panel hypha:border hypha:border-rule hypha:bg-panel hypha:p-6">
  <Heading class="hypha:flex hypha:items-center hypha:gap-3 hypha:border-b hypha:border-rule hypha:pb-4 hypha:font-serif hypha:text-lg hypha:leading-tight hypha:font-normal hypha:text-ink">
    {icon && <span class="hypha:text-graphite"><NamedIcon name={icon} size="md" /></span>}
    {title}
  </Heading>
  <div
    class="hypha:leading-relaxed hypha:text-graphite hypha:[&_code]:rounded-control hypha:[&_code]:bg-raised hypha:[&_code]:px-[0.36em] hypha:[&_code]:py-[0.12em] hypha:[&_code]:font-mono hypha:[&_code]:text-[0.875em]"
  >
    <slot />
  </div>
  <div class="hypha:self-end">
    {
      href && (
        <a href={withBase(href)} class="hypha:btn hypha:mt-2 hypha:no-underline">
          {linkText}
          <Icon icon={ArrowRight} class="hypha:rtl:-scale-x-100" />
        </a>
      )
    }
  </div>
</article>
