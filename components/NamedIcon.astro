---
import { icons as lucide } from "@lucide/astro";
import { Icon as StarlightIcon } from "@astrojs/starlight/components";
import { componentName, type IconName } from "../libs/config";
import Icon from "./Icon.astro";

interface Props {
  name: IconName;
  size?: "xs" | "sm" | "md" | "lg";
}

const ICON_PX = { xs: 12, sm: 16, md: 20, lg: 24 } as const;
const { name, size = "sm" } = Astro.props;
const drawn = lucide[componentName(name) as keyof typeof lucide];
if (name !== "starlight" && !drawn) throw new Error(`starlight-theme-hypha: no Lucide icon is named "${name}"`);
---

{name === "starlight" ? <StarlightIcon name="starlight" size={`${ICON_PX[size]}px`} class="hypha:shrink-0" /> : <Icon icon={drawn} size={size} />}
