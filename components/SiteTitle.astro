---
// Starlight's logo and title. With the theme's `brand`, the brand comes
// first and the title follows it in graphite, as "hypha.solidtype".
import config from "virtual:starlight-theme-hypha/config";
import starlight from "virtual:starlight/user-config";
import { logos } from "virtual:starlight/user-images";

const { siteTitle, siteTitleHref } = Astro.locals.starlightRoute;
const name = config.brand ? `${config.brand}.${siteTitle}` : siteTitle;
// Night only: a logo given for both themes is drawn in its dark one.
const logo = logos.dark;
---

<a href={siteTitleHref} class="wordmark flex shrink-0 items-center gap-2 text-ink no-underline pointer-coarse:min-h-11" aria-label={`${name}, home`}>
  {logo && <img src={logo.src} alt="" width={logo.width} height={logo.height} class="h-7 w-auto" />}
  <span translate="no" class:list={["text-lg/none font-medium tracking-[-0.01em]", { "sr-only": starlight.logo?.replacesTitle }]}>
    {config.brand ? (<>{config.brand}<span class="text-graphite">.{siteTitle}</span></>) : siteTitle}
  </span>
</a>
