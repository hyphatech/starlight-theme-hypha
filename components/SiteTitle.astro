---
// Starlight's logo and title. With the theme's `brand`, the brand comes
// first and the title follows it in graphite, as "hypha.solidtype".
import config from "virtual:starlight-theme-hypha/config";
import starlight from "virtual:starlight/user-config";
import { logos } from "virtual:starlight/user-images";

const { siteTitle, siteTitleHref } = Astro.locals.starlightRoute;
const name = config.brand ? `${config.brand}.${siteTitle}` : siteTitle;
// Night only: a logo given for both themes is drawn in its dark one.
const logo = logos.dark;
---

<a href={siteTitleHref} class="wordmark hypha:flex hypha:shrink-0 hypha:items-center hypha:gap-2 hypha:text-ink hypha:no-underline hypha:pointer-coarse:min-h-11" aria-label={`${name}, home`}>
  {logo && <img src={logo.src} alt="" width={logo.width} height={logo.height} class="hypha:h-7 hypha:w-auto" />}
  <span translate="no" class:list={["hypha:text-lg/none hypha:font-medium hypha:tracking-[-0.01em]", { "hypha:sr-only": starlight.logo?.replacesTitle }]}>
    {config.brand ? (<>{config.brand}<span class="hypha:text-graphite">.{siteTitle}</span></>) : siteTitle}
  </span>
</a>
