---
import config from "virtual:starlight-theme-hypha/config";
import starlight from "virtual:starlight/user-config";
import { logos } from "virtual:starlight/user-images";
import { say } from "../libs/words";

const { siteTitle, siteTitleHref } = Astro.locals.starlightRoute;
const name = config.brand ? `${config.brand}.${siteTitle}` : siteTitle;
const both = config.schemes.length === 2 && logos.dark && logos.light && logos.dark.src !== logos.light.src;
const shown = both
  ? [
      { logo: logos.dark, only: "hypha:[[data-theme=light]_&]:hidden" },
      { logo: logos.light, only: "hypha:[[data-theme=dark]_&]:hidden" },
    ]
  : [{ logo: config.schemes[0] === "light" ? (logos.light ?? logos.dark) : (logos.dark ?? logos.light), only: "" }];
---

<a href={siteTitleHref} class="wordmark hypha:flex hypha:min-w-0 hypha:items-center hypha:gap-2 hypha:text-ink hypha:no-underline hypha:pointer-coarse:min-h-11" aria-label={say(Astro.locals.t, "hypha.siteTitle.home", { title: name })}>
  {shown.map(({ logo, only }) => logo && <img src={logo.src} alt="" width={logo.width} height={logo.height} class:list={["hypha:h-7 hypha:w-auto hypha:shrink-0", only]} />)}
  <span translate="no" title={name} class:list={["hypha:truncate hypha:text-lg/snug hypha:font-medium hypha:tracking-[-0.01em]", { "hypha:sr-only": starlight.logo?.replacesTitle }]}>
    {config.brand ? (<>{config.brand}<span class="hypha:text-graphite">.{siteTitle}</span></>) : siteTitle}
  </span>
</a>
