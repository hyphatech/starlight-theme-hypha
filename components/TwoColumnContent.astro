---
// The page and its contents, as hypha.pub sets a post and its notes: the
// text at the measure, the contents in the column to its right where
// hypha.pub keeps its sidenotes, from the width that has room for both.
// Narrower, the page goes without them, as a post does.
---

<div class:list={["columns", { "with-contents": Astro.locals.starlightRoute.toc }]}>
  <div class="main-pane"><slot /></div>
  {
    Astro.locals.starlightRoute.toc && (
      <aside class="contents print:hidden">
        <slot name="right-sidebar" />
      </aside>
    )
  }
</div>

<style>
  .main-pane {
    min-width: 0;
    max-width: var(--measure);
    isolation: isolate;
  }
  /* A landing page is the page's whole width: its hero and its cards, its
     text still at the measure. */
  :global([data-has-hero]) .main-pane {
    max-width: none;
  }
  .contents {
    display: none;
  }
  @media (min-width: 80rem) {
    .columns.with-contents {
      display: grid;
      grid-template-columns: minmax(0, var(--measure)) var(--sidebar);
      column-gap: var(--column-gap);
    }
    .contents {
      display: block;
    }
  }
</style>
