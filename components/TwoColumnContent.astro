---
const splash = Astro.locals.starlightRoute.entry.data.template === "splash";
---

<div
  class:list={[
    Astro.locals.starlightRoute.toc && "hypha:xl:grid hypha:xl:grid-cols-[minmax(0,var(--hypha-measure))_var(--hypha-sidebar)] hypha:xl:gap-x-(--hypha-column-gap)",
  ]}
>
  <div class:list={["hypha:isolate hypha:min-w-0", splash ? "hypha:max-w-none" : "hypha:max-w-(--hypha-measure)"]}><slot /></div>
  {
    Astro.locals.starlightRoute.toc && (
      <aside class="hypha:hidden hypha:xl:block hypha:print:hidden">
        <slot name="right-sidebar" />
      </aside>
    )
  }
</div>
