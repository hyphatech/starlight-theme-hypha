---
// The text at the measure and the page's contents beside it, where
// hypha.pub keeps a post's sidenotes; narrower, the text alone. A splash
// page is the page's width.
const splash = Astro.locals.starlightRoute.entry.data.template === "splash";
---

<div
  class:list={[
    Astro.locals.starlightRoute.toc && "xl:grid xl:grid-cols-[minmax(0,var(--measure))_var(--sidebar)] xl:gap-x-(--column-gap)",
  ]}
>
  <div class:list={["isolate min-w-0", splash ? "max-w-none" : "max-w-(--measure)"]}><slot /></div>
  {
    Astro.locals.starlightRoute.toc && (
      <aside class="hidden xl:block print:hidden">
        <slot name="right-sidebar" />
      </aside>
    )
  }
</div>
