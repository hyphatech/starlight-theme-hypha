---
// The text at the measure and the page's contents beside it, where
// hypha.pub keeps a post's sidenotes; narrower, the text alone.
---

<div
  class:list={[
    Astro.locals.starlightRoute.toc && "xl:grid xl:grid-cols-[minmax(0,var(--measure))_var(--sidebar)] xl:gap-x-(--column-gap)",
  ]}
>
  <div class="isolate min-w-0 max-w-(--measure) in-data-has-hero:max-w-none"><slot /></div>
  {
    Astro.locals.starlightRoute.toc && (
      <aside class="hidden xl:block print:hidden">
        <slot name="right-sidebar" />
      </aside>
    )
  }
</div>
