---
// With an `aside`, the image is a mark above the title; else the art beside it.
import { Image } from "astro:assets";
import type { ComponentProps } from "astro/types";
import config from "virtual:starlight-theme-hypha/config";
import Actions from "./Actions.astro";

interface Props {
  title: string;
  tagline?: string;
  image?: { file?: ImageMetadata; dark?: ImageMetadata; light?: ImageMetadata; html?: string; alt?: string };
  actions?: ComponentProps<typeof Actions>["actions"];
}

// Starlight's title id, which its table of contents links to.
const PAGE_TITLE_ID = "_top";
const { title, tagline, image, actions = [] } = Astro.props;
const aside = Astro.slots.has("aside");

const pair = image?.dark && image.light && image.dark !== image.light;
const arts = image?.file
  ? [{ src: image.file, only: "" }]
  : pair && config.schemes.length === 2
    ? [
        { src: image.dark!, only: "hypha:[[data-theme=light]_&]:hidden" },
        { src: image.light!, only: "hypha:[[data-theme=dark]_&]:hidden" },
      ]
    : [image?.[config.schemes[0]] ?? image?.dark ?? image?.light].flatMap((src) => (src ? [{ src, only: "" }] : []));
const art = arts.length > 0;
const html = art ? undefined : image?.html;
const artLook = "hypha:h-auto hypha:w-[min(70%,20rem)] hypha:justify-self-center hypha:lg:w-[min(100%,24rem)]";
---

<div
  class:list={[
    "landing not-content hypha:grid hypha:grid-cols-[minmax(0,1fr)] hypha:items-center hypha:gap-12 hypha:pt-12 hypha:pb-8 hypha:md:pt-16 hypha:md:pb-12",
    aside ? "hypha:lg:grid-cols-2 hypha:lg:gap-16" : (art || html) && "hypha:lg:grid-cols-[7fr_4fr]",
  ]}
>
  <div class="hypha:min-w-0">
    {aside && arts.map(({ src, only }) => <Image src={src} alt={image?.alt ?? ""} loading="eager" decoding="async" class:list={["hypha:mb-10 hypha:h-auto hypha:w-[min(100%,20rem)]", only]} />)}
    <h1
      id={PAGE_TITLE_ID}
      data-page-title
      class:list={[
        aside ? "hypha:font-serif hypha:text-[clamp(2rem,3.6vw,3rem)] hypha:leading-[1.1] hypha:font-normal hypha:tracking-[-0.02em] hypha:text-balance" : "hypha:t-display hypha:max-w-3xl",
        "hypha:text-ink hypha:lining-nums hypha:tabular-nums",
      ]}
      set:html={title}
    />
    {tagline && <p class="hypha:t-lede hypha:mt-7 hypha:max-w-[34rem] hypha:text-pretty hypha:text-graphite" set:html={tagline} />}
    {
      Astro.slots.has("default") && (
        <div class="hypha:mt-8 hypha:max-w-[34rem]">
          <slot />
        </div>
      )
    }
    {
      actions.length > 0 && (
        <div class="hypha:mt-10 hypha:flex hypha:flex-wrap hypha:gap-3">
          <Actions actions={actions} />
        </div>
      )
    }
  </div>
  {
    aside ? (
      <div class="landing-aside hypha:min-w-0">
        <slot name="aside" />
      </div>
    ) : (
      <>
        {arts.map(({ src, only }) => <Image src={src} alt={image?.alt ?? ""} loading="eager" decoding="async" width={400} height={400} class:list={[artLook, only]} />)}
        {html && <div class={artLook} set:html={html} />}
      </>
    )
  }
</div>
