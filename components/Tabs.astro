---
// The second row: the sidebar's top-level groups as tabs, the open one
// marked on the header's rule, and at its end the project's links, then the
// repository past a rule. A phone has its own.
import config from "virtual:starlight-theme-hypha/config";
import GitHub from "./GitHub.astro";
import Links from "./Links.astro";
import NamedIcon from "./NamedIcon.astro";

const tabs = Astro.locals.hyphaTabs ?? [];
const icon = (label: string) => (typeof config.tabs === "object" ? config.tabs[label] : undefined);
const links = config.links.length > 0;
const github = config.github !== undefined;
---

{
  (tabs.length > 0 || links || github) && (
    <div class="site-tabs hypha:hidden hypha:border-t hypha:border-rule hypha:md:block hypha:print:hidden">
      <nav class="hypha:mx-auto hypha:-mb-px hypha:max-w-page" aria-label="Sections">
        <ul class="hypha:no-scrollbar hypha:m-0 hypha:flex hypha:list-none hypha:items-center hypha:gap-6 hypha:overflow-x-auto hypha:px-(--hypha-gutter) hypha:py-0">
          {tabs.map((tab) => (
            <li class="hypha:shrink-0">
              <a href={tab.href} aria-current={tab.isCurrent ? "true" : undefined} class="hypha:tab-link">
                {icon(tab.label) && <NamedIcon name={icon(tab.label)!} />}
                {tab.label}
              </a>
            </li>
          ))}
          {(links || github) && <li class="hypha:ms-auto" aria-hidden="true" />}
          <Links row="tabs" />
          {links && github && <li class="hypha:h-5 hypha:w-px hypha:shrink-0 hypha:bg-rule" aria-hidden="true" />}
          {github && (
            <li class="hypha:flex hypha:shrink-0">
              <GitHub />
            </li>
          )}
        </ul>
      </nav>
    </div>
  )
}
