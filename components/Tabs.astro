---
// The sidebar's top-level entries as tabs under the header, the open one
// marked on the header's rule. A phone has them in its second row.
import config from "virtual:starlight-theme-hypha/config";
import NamedIcon from "./NamedIcon.astro";

const tabs = Astro.locals.hyphaTabs ?? [];
const icon = (label: string) => (typeof config.tabs === "object" ? config.tabs[label] : undefined);
---

{
  tabs.length > 0 && (
    <div class="hidden border-t border-rule md:block print:hidden">
      <nav class="mx-auto -mb-px max-w-page" aria-label="Sections">
        <ul class="no-scrollbar m-0 flex list-none gap-6 overflow-x-auto px-(--gutter) py-0">
          {tabs.map((tab) => (
            <li class="shrink-0">
              <a
                href={tab.href}
                aria-current={tab.isCurrent ? "true" : undefined}
                class="t-control flex h-12 items-center gap-2 border-b border-transparent whitespace-nowrap text-graphite no-underline transition-colors [--ring-offset:-2px] hover:text-ink aria-[current]:border-ink aria-[current]:text-ink"
              >
                {icon(tab.label) && <NamedIcon name={icon(tab.label)!} />}
                {tab.label}
              </a>
            </li>
          ))}
        </ul>
      </nav>
    </div>
  )
}
