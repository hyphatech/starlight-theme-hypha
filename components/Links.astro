---
// The project's links. One to another site opens in a new tab, so the
// reader keeps their place.
import config from "virtual:starlight-theme-hypha/config";
import NamedIcon from "./NamedIcon.astro";

interface Props {
  // Each link in a list item, in a phone's row.
  listed?: boolean;
}

const { listed = false } = Astro.props;
const external = (href: string) => /^https?:\/\//.test(href);
---

{
  config.links.map((link) => {
    const a = (
      <a href={link.href} class={listed ? "row-link" : "bar-link"} {...(external(link.href) && { target: "_blank", rel: "noopener" })}>
        {link.icon && <NamedIcon name={link.icon} />}
        {link.label}
      </a>
    );
    return listed ? <li>{a}</li> : a;
  })
}
