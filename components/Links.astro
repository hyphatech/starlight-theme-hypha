---
// The project's links. One to another site opens in a new tab, so the
// reader keeps their place.
import config from "virtual:starlight-theme-hypha/config";
import NamedIcon from "./NamedIcon.astro";

interface Props {
  // In a row of tabs, each link in a list item.
  row?: "tabs" | "phone";
}

const { row } = Astro.props;
const look = { tabs: "hypha:tab-link", phone: "hypha:row-link" }[row ?? ""] ?? "hypha:bar-link";
const external = (href: string) => /^https?:\/\//.test(href);
---

{
  config.links.map((link) => {
    const a = (
      <a href={link.href} class={look} {...(external(link.href) && { target: "_blank", rel: "noopener" })}>
        {link.icon && <NamedIcon name={link.icon} />}
        {link.label}
      </a>
    );
    return row ? <li class="hypha:shrink-0">{a}</li> : a;
  })
}
