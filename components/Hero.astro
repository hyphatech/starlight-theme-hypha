---
import Landing from "./Landing.astro";
import NotFound from "./NotFound.astro";

const { id, entry } = Astro.locals.starlightRoute;
const { title = entry.data.title, tagline, image, actions = [] } = entry.data.hero ?? {};
---

{id === "404" ? <NotFound title={entry.data.hero?.title} tagline={tagline} actions={actions} /> : <Landing title={title} tagline={tagline} image={image} actions={actions} />}
