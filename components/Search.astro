---
// Search, as Zensical's: a panel over the page, each result a heading under
// its trail. The arrows choose, Enter opens, Escape closes. It asks
// Pagefind's index directly: Pagefind's default UI knows no arrows.
import ArrowDown from "@lucide/astro/icons/arrow-down";
import ArrowUp from "@lucide/astro/icons/arrow-up";
import CornerDownLeft from "@lucide/astro/icons/corner-down-left";
import Magnifier from "@lucide/astro/icons/search";
import project from "virtual:starlight/project-context";
import starlight from "virtual:starlight/user-config";
import Icon from "./Icon.astro";

const t = Astro.locals.t;
// Pagefind's words as Starlight translates them, English where it does not.
const pagefind = Object.fromEntries(
  Object.entries(t.all())
    .filter(([key]) => key.startsWith("pagefind."))
    .map(([key, value]) => [key.replace("pagefind.", ""), value]),
);
const words = {
  zero: pagefind.zero_results ?? "No results for [SEARCH_TERM]",
  one: pagefind.one_result ?? "[COUNT] result for [SEARCH_TERM]",
  many: pagefind.many_results ?? "[COUNT] results for [SEARCH_TERM]",
  more: pagefind.load_more ?? "Load more results",
  dev: t("search.devWarning"),
};
const key = "hypha:inline-grid hypha:h-5 hypha:min-w-5 hypha:place-items-center hypha:rounded-control hypha:bg-raised hypha:px-1 hypha:font-sans hypha:text-[0.6875rem] hypha:text-ink";
---

{
  starlight.pagefind && (
    <hypha-search class="hypha:contents" data-words={JSON.stringify(words)} data-strip-trailing-slash={project.trailingSlash === "never" ? "" : undefined}>
      {/* On a phone a square, as the menu's button beside it. */}
      <button
        type="button"
        class="open hypha:flex hypha:size-11 hypha:cursor-pointer hypha:items-center hypha:justify-center hypha:gap-2 hypha:rounded-control hypha:border hypha:border-rule hypha:bg-panel hypha:p-0 hypha:font-sans hypha:text-[0.875rem]/none hypha:font-medium hypha:text-graphite hypha:transition-colors hypha:hover:border-graphite hypha:hover:text-ink hypha:min-[50rem]:h-10 hypha:min-[50rem]:w-72 hypha:min-[50rem]:justify-start hypha:min-[50rem]:ps-3 hypha:min-[50rem]:pe-2"
        disabled
        aria-label={t("search.label")}
        aria-keyshortcuts="Control+K"
      >
        <Icon icon={Magnifier} />
        <span class="hypha:hidden hypha:min-[50rem]:block" aria-hidden="true">
          {t("search.label")}
        </span>
        <kbd class="shortcut hypha:ms-auto hypha:hidden hypha:gap-[0.25em] hypha:rounded-control hypha:bg-raised hypha:px-1.5 hypha:py-1 hypha:font-sans hypha:text-[0.6875rem] hypha:*:font-sans hypha:min-[50rem]:flex" aria-hidden="true">
          <kbd>{t("search.ctrlKey")}</kbd>
          <kbd>K</kbd>
        </kbd>
      </button>
      {/* Before the page paints, Apple's key where it is the one. */}
      <script is:inline>
        (() => {
          const button = document.currentScript?.previousElementSibling;
          const key = button?.querySelector(".shortcut kbd");
          if (key && /(Mac|iPhone|iPod|iPad)/i.test(navigator.platform)) {
            key.textContent = "⌘";
            button.setAttribute("aria-keyshortcuts", "Meta+K");
          }
        })();
      </script>

      {/* On a phone the whole screen. It goes quicker than it comes. */}
      <dialog
        aria-label={t("search.label")}
        class="hypha:m-0 hypha:h-dvh hypha:max-h-dvh hypha:w-full hypha:max-w-full hypha:flex-col hypha:focus-visible:outline-none! hypha:overflow-hidden hypha:border-0 hypha:bg-panel hypha:p-0 hypha:text-ink hypha:transition-[opacity,translate] hypha:duration-200 hypha:ease-glide hypha:open:flex hypha:starting:open:-translate-y-2 hypha:starting:open:opacity-0 hypha:data-closing:-translate-y-1 hypha:data-closing:opacity-0 hypha:data-closing:duration-120 hypha:data-closing:ease-state hypha:motion-reduce:transition-none hypha:min-[50rem]:inset-y-auto hypha:min-[50rem]:top-0 hypha:min-[50rem]:mx-auto hypha:min-[50rem]:mt-20 hypha:min-[50rem]:h-auto hypha:min-[50rem]:max-h-[min(36rem,100dvh_-_8rem)] hypha:min-[50rem]:w-[min(40rem,100%_-_2*var(--hypha-gutter))] hypha:min-[50rem]:rounded-panel hypha:min-[50rem]:border hypha:min-[50rem]:border-rule hypha:backdrop:bg-ivory/72 hypha:backdrop:backdrop-blur-[3px] hypha:backdrop:transition-opacity hypha:backdrop:duration-180 hypha:backdrop:ease-glide hypha:starting:open:backdrop:opacity-0 hypha:data-closing:backdrop:opacity-0 hypha:data-closing:backdrop:duration-120 hypha:data-closing:backdrop:ease-state hypha:motion-reduce:backdrop:transition-none"
      >
        <div class="hypha:flex hypha:h-14 hypha:shrink-0 hypha:items-center hypha:gap-3 hypha:border-b hypha:border-rule hypha:ps-5 hypha:pe-3 hypha:text-graphite">
          <Icon icon={Magnifier} size="md" />
          {/* The caret is the field's focus; the page's ring would box it twice. */}
          <input
            type="text"
            role="combobox"
            aria-label={t("search.label")}
            aria-expanded="false"
            aria-controls="hypha-search-results"
            aria-autocomplete="list"
            placeholder={t("search.label")}
            autocomplete="off"
            autocapitalize="off"
            spellcheck="false"
            enterkeyhint="search"
            class="hypha:h-full hypha:min-w-0 hypha:flex-1 hypha:border-0 hypha:bg-transparent hypha:font-sans hypha:text-base/none hypha:font-normal hypha:text-ink hypha:caret-accent hypha:outline-0 hypha:placeholder:text-graphite hypha:focus-visible:outline-none!"
          />
          <button
            type="button"
            class="hypha:cursor-pointer hypha:border-0 hypha:bg-transparent hypha:p-2 hypha:font-sans hypha:text-[0.875rem]/none hypha:font-medium hypha:text-ink hypha:min-[50rem]:hidden"
            data-close
          >
            {t("search.cancelLabel")}
          </button>
        </div>
        <p class="status hypha:m-0 hypha:shrink-0 hypha:px-5 hypha:pt-3.5 hypha:pb-1.5 hypha:text-[0.75rem] hypha:font-medium hypha:whitespace-pre-line hypha:text-graphite hypha:empty:hidden" role="status" />
        <div
          class="results hypha:min-h-0 hypha:flex-[0_1_auto] hypha:overflow-y-auto hypha:overscroll-contain hypha:px-2 hypha:pb-2 hypha:[scrollbar-color:var(--hypha-color-rule)_transparent] hypha:[scrollbar-width:thin] hypha:empty:hidden"
          id="hypha-search-results"
          role="listbox"
          aria-label={t("search.label")}
        />
        <button
          type="button"
          class="more hypha:mx-5 hypha:mb-3 hypha:shrink-0 hypha:cursor-pointer hypha:border-0 hypha:bg-transparent hypha:px-0 hypha:py-2 hypha:text-start hypha:font-sans hypha:text-[0.8125rem]/none hypha:font-medium hypha:text-graphite hypha:transition-colors hypha:hover:text-ink"
          hidden
        >
          {words.more}
        </button>
        {/* The keys, where there is a keyboard to press them on. */}
        <footer class="hypha:hidden hypha:shrink-0 hypha:gap-5 hypha:border-t hypha:border-rule hypha:px-5 hypha:py-2.5 hypha:text-[0.75rem] hypha:text-graphite hypha:*:inline-flex hypha:*:items-center hypha:*:gap-1 hypha:min-[50rem]:flex" aria-hidden="true">
          <span>
            <kbd class={key}>
              <Icon icon={ArrowUp} size="xs" />
            </kbd>
            <kbd class:list={[key, "hypha:me-0.5"]}>
              <Icon icon={ArrowDown} size="xs" />
            </kbd>
            to choose
          </span>
          <span>
            <kbd class:list={[key, "hypha:me-0.5"]}>
              <Icon icon={CornerDownLeft} size="xs" />
            </kbd>
            to open
          </span>
          <span>
            <kbd class:list={[key, "hypha:me-0.5"]}>esc</kbd>
            to close
          </span>
        </footer>
      </dialog>
    </hypha-search>
  )
}

<script>
  // As much of Pagefind's API as is used.
  interface SubResult {
    title: string;
    url: string;
    excerpt: string;
    locations: number[];
  }
  interface Page {
    url: string;
    excerpt: string;
    meta: { title?: string; section?: string };
    sub_results: SubResult[];
  }
  interface Pagefind {
    options(options: { baseUrl: string }): Promise<void>;
    init(): Promise<void>;
    debouncedSearch(query: string, options?: object, ms?: number): Promise<{ results: { data(): Promise<Page> }[] } | null>;
  }

  interface Row {
    trail: string[];
    title: string;
    url: string;
    excerpt: string;
  }

  // A page's rows: its three headings with the most found under them. A
  // heading's trail ends with its page; a group named as its page is named
  // once.
  function rows(page: Page): Row[] {
    const title = page.meta.title ?? page.url;
    const groups = page.meta.section ? page.meta.section.split(" / ") : [];
    const trail = groups.at(-1) === title ? groups.slice(0, -1) : groups;
    const own = { trail, title, url: page.url, excerpt: page.excerpt };
    const subs = [...page.sub_results].sort((a, b) => b.locations.length - a.locations.length).slice(0, 3);
    if (subs.length === 0) return [own];
    return subs.map((sub) =>
      sub.url.includes("#") && sub.title !== title
        ? { trail: [...trail, title], title: sub.title, url: sub.url, excerpt: sub.excerpt }
        : { ...own, excerpt: sub.excerpt },
    );
  }

  const PAGES_AT_ONCE = 8;
  const reduced = window.matchMedia("(prefers-reduced-motion: reduce)");

  class HyphaSearch extends HTMLElement {
    connectedCallback() {
      const open = this.querySelector<HTMLButtonElement>("button.open")!;
      const dialog = this.querySelector("dialog")!;
      const input = dialog.querySelector("input")!;
      const status = dialog.querySelector<HTMLElement>(".status")!;
      const list = dialog.querySelector<HTMLElement>(".results")!;
      const more = dialog.querySelector<HTMLButtonElement>(".more")!;
      const words = JSON.parse(this.dataset.words ?? "{}") as Record<string, string>;
      const strip = this.dataset.stripTrailingSlash !== undefined;
      const href = (url: string) => (strip ? url.replace(/(.)\/(#.*)?$/, "$1$2") : url);
      const base = import.meta.env.BASE_URL.replace(/\/$/, "");

      let pagefind: Promise<Pagefind | undefined> | undefined;
      const index = () =>
        (pagefind ??= import(/* @vite-ignore */ `${base}/pagefind/pagefind.js`)
          .then(async (module: Pagefind) => {
            await module.options({ baseUrl: import.meta.env.BASE_URL });
            await module.init();
            return module;
          })
          .catch(() => undefined));

      // A search begun after another makes the other's answer stale.
      let pages: { data(): Promise<Page> }[] = [];
      let drawn = 0;
      let chosen = -1;
      let asked = 0;

      const say = (template: string, count: number, query: string) => {
        status.textContent = template.replace("[COUNT]", String(count)).replace("[SEARCH_TERM]", query);
      };

      const options = () => [...list.querySelectorAll<HTMLAnchorElement>("[role=option]")];

      const choose = (i: number, scroll = true) => {
        const all = options();
        if (all.length === 0) return;
        chosen = Math.max(0, Math.min(i, all.length - 1));
        all.forEach((option, j) => option.setAttribute("aria-selected", String(j === chosen)));
        input.setAttribute("aria-activedescendant", all[chosen].id);
        if (scroll) all[chosen].scrollIntoView({ block: "nearest" });
      };

      const draw = (row: Row, n: number) => {
        const option = document.createElement("a");
        option.id = `hypha-search-${n}`;
        option.href = href(row.url);
        option.setAttribute("role", "option");
        option.setAttribute("aria-selected", "false");
        option.className = "hypha:grid hypha:gap-0.5 hypha:rounded-control hypha:px-3 hypha:py-2.5 hypha:text-graphite hypha:no-underline hypha:transition-colors hypha:aria-selected:bg-raised";
        if (row.trail.length > 0) {
          const trail = document.createElement("span");
          trail.className = "hypha:truncate hypha:text-xs/[1.5]";
          trail.textContent = row.trail.join(" / ");
          option.append(trail);
        }
        const title = document.createElement("span");
        title.className = "hypha:text-[0.9375rem]/[1.4] hypha:font-medium hypha:text-ink";
        title.textContent = row.title;
        // Pagefind's excerpt is escaped, with the words found in <mark>.
        const excerpt = document.createElement("span");
        excerpt.className =
          "hypha:line-clamp-2 hypha:text-[0.8125rem]/[1.55] hypha:wrap-anywhere hypha:[&_mark]:bg-transparent hypha:[&_mark]:text-ink hypha:[&_mark]:underline hypha:[&_mark]:decoration-accent hypha:[&_mark]:decoration-1 hypha:[&_mark]:underline-offset-3";
        excerpt.innerHTML = row.excerpt;
        option.append(title, excerpt);
        return option;
      };

      const drawMore = async (query: string, ask: number) => {
        const batch = pages.slice(drawn, drawn + PAGES_AT_ONCE);
        const found = await Promise.all(batch.map((page) => page.data()));
        if (ask !== asked) return;
        const first = drawn === 0;
        drawn += batch.length;
        const n = options().length;
        list.append(...found.flatMap(rows).map((row, i) => draw(row, n + i)));
        more.hidden = drawn >= pages.length;
        say(pages.length === 1 ? words.one : words.many, pages.length, query);
        if (first) choose(0, false);
      };

      const search = async () => {
        const query = input.value.trim();
        const ask = ++asked;
        if (query === "") {
          pages = [];
          drawn = 0;
          chosen = -1;
          list.replaceChildren();
          status.textContent = "";
          more.hidden = true;
          input.setAttribute("aria-expanded", "false");
          input.removeAttribute("aria-activedescendant");
          return;
        }
        const found = await (await index())?.debouncedSearch(query, {}, 120);
        if (!found || ask !== asked) return;
        pages = found.results;
        drawn = 0;
        chosen = -1;
        list.replaceChildren();
        input.removeAttribute("aria-activedescendant");
        input.setAttribute("aria-expanded", String(pages.length > 0));
        more.hidden = true;
        if (pages.length === 0) say(words.zero, 0, query);
        else await drawMore(query, ask);
      };

      // Closed after it has faded: a closed dialog leaves the page at once.
      const show = () => {
        delete dialog.dataset.closing;
        document.documentElement.classList.add("hypha:overflow-hidden");
        dialog.showModal();
        input.focus();
        input.select();
      };
      const hide = () => {
        if (!dialog.open || dialog.dataset.closing !== undefined) return;
        if (reduced.matches) return dialog.close();
        dialog.dataset.closing = "";
        const done = () => {
          if (dialog.dataset.closing === undefined) return;
          delete dialog.dataset.closing;
          dialog.close();
        };
        dialog.addEventListener("transitionend", done, { once: true });
        setTimeout(done, 200);
      };

      dialog.addEventListener("close", () => document.documentElement.classList.remove("hypha:overflow-hidden"));
      open.addEventListener("click", show);
      open.disabled = false;
      dialog.querySelector("[data-close]")!.addEventListener("click", hide);
      // Escape, and a click on the dimmed page around the panel.
      dialog.addEventListener("cancel", (event) => {
        event.preventDefault();
        hide();
      });
      dialog.addEventListener("click", (event) => {
        if (event.target === dialog) hide();
      });
      // The page followed may be this one, at another heading.
      list.addEventListener("click", (event) => {
        if ((event.target as Element).closest("[role=option]")) hide();
      });
      // The mouse chooses as it moves, not as the list scrolls under it.
      list.addEventListener("pointermove", (event) => {
        const option = (event.target as Element).closest<HTMLAnchorElement>("[role=option]");
        if (option) choose(options().indexOf(option), false);
      });
      more.addEventListener("click", () => drawMore(input.value.trim(), asked));

      input.addEventListener("input", search);
      input.addEventListener("keydown", (event) => {
        if (event.key === "ArrowDown" || event.key === "ArrowUp") {
          event.preventDefault();
          choose(chosen + (event.key === "ArrowDown" ? 1 : -1));
        } else if (event.key === "Enter" && !event.isComposing) {
          event.preventDefault();
          const option = options()[chosen];
          if (!option) return;
          hide();
          if (event.metaKey || event.ctrlKey) window.open(option.href, "_blank");
          else window.location.assign(option.href);
        }
      });

      // ⌘K or Ctrl+K anywhere, and / where nothing is being written.
      window.addEventListener("keydown", (event) => {
        if ((event.metaKey || event.ctrlKey) && event.key === "k") {
          event.preventDefault();
          dialog.open ? hide() : show();
        } else if (event.key === "/" && !dialog.open) {
          const target = event.target as HTMLElement;
          if (target.isContentEditable || /^(INPUT|TEXTAREA|SELECT)$/.test(target.tagName)) return;
          event.preventDefault();
          show();
        }
      });

      // The index is built with the site: none in the dev server.
      if (import.meta.env.DEV) {
        status.textContent = words.dev;
        input.disabled = true;
        return;
      }
      const idle = window.requestIdleCallback ?? ((then: () => void) => setTimeout(then, 1));
      idle(() => void index());
    }
  }
  customElements.define("hypha-search", HyphaSearch);
</script>
